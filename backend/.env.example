PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free-tier model (no cost). OpenRouter's free lineup changes and gets
# overloaded often -- check https://openrouter.ai/collections/free-models if
# this ID stops working, and swap it here without touching code.
# Verified working as of writing: nvidia/nemotron-3-super-120b-a12b:free
# Backup that also worked when the above was saturated: inclusionai/ling-3.0-flash-vl:free
# Free tier is also rate-limited (20 req/min, 50 req/day, 1000/day after a
# one-time $10 top-up).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Used only when a page has almost no body text and crawler.service.ts finds
# a candidate poster/notice image instead (a free vision-capable model --
# check https://openrouter.ai/collections/vision-models if this ID stops
# working). Not charged: this stays on OpenRouter's free tier, same as
# OPENROUTER_MODEL above.
# nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free was tried first and
# reliably failed against a real poster image (empty completions, then full
# 120s timeouts). Swapped to this one -- re-verify if it also proves flaky.
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b:free

# milliseconds
CRAWL_TIMEOUT_MS=8000
# Free-tier response time varies a lot (observed ~15s typical, 45s+ during
# provider queueing, occasionally 90s+) -- 120s balances waiting for a valid
# slow response against making the user stare at the loading screen forever.
OPENROUTER_TIMEOUT_MS=120000
