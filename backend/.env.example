PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free-tier model (no cost). OpenRouter's free lineup changes and gets
# overloaded often -- check https://openrouter.ai/collections/free-models if
# this ID stops working, and swap it here without touching code.
# Verified working as of writing: nvidia/nemotron-3-super-120b-a12b:free
# Backup that also worked when the above was saturated: inclusionai/ling-3.0-flash-vl:free
# Free tier is also rate-limited (20 req/min, 50 req/day, 1000/day after a
# one-time $10 top-up).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# milliseconds
CRAWL_TIMEOUT_MS=8000
# Free-tier response time varies a lot (observed ~15s typical, 45s+ during
# provider queueing) -- 60s balances waiting for a valid slow response
# against making the user stare at the loading screen forever.
OPENROUTER_TIMEOUT_MS=60000
